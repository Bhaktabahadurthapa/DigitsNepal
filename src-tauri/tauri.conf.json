{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigitsNepal",
  "version": "0.1.0",
  "identifier": "org.digitsnepal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "DigitsNepal",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      },
      {
        "label": "popover",
        "title": "DigitsNepal Quick Translate",
        "url": "index.html?view=popover",
        "width": 460,
        "height": 340,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Every Nepali Word Has Meaning.",
    "longDescription": "DigitsNepal is a privacy-first Nepali-English writing and translation assistant for macOS.",
    "copyright": "MIT License — DigitsNepal contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": null
    }
  }
}
